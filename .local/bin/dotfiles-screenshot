#!/usr/bin/env bash

MODE=$1
DIR="$HOME/Pictures"
mkdir -p "$DIR"

GEOMETRY=$(slurp 2>/dev/null)

if [ -z "$GEOMETRY" ]; then
    exit 0
fi

if [ "$MODE" = "save" ]; then
    FILENAME="Screenshot-$(date +'%Y-%m-%d-%H%M%S').png"
    FILEPATH="$DIR/$FILENAME"
    
    grim -g "$GEOMETRY" - | tee "$FILEPATH" | wl-copy
    notify-send -t 2000 "screenshot" "saved to $DIR/$FILENAME"
else
    grim -g "$GEOMETRY" - | wl-copy
    notify-send -t 2000 "screenshot" "saved to clipboard"
fi
