#!/usr/bin/env bash

ACTION="${1:-play-pause}"

case "$ACTION" in
    play-pause|next|previous|stop)
        playerctl "$ACTION" || exit 1
        ;;
    *)
        exit 1
        ;;
esac

STATUS=$(playerctl status 2>/dev/null || true)
TRACK=$(playerctl metadata --format '{{ artist }} - {{ title }}' 2>/dev/null || true)

[ -n "$TRACK" ] || TRACK="unknown track"

case "$ACTION" in
    play-pause)
        MESSAGE="$(printf '%s' "$STATUS" | tr '[:upper:]' '[:lower:]'): $TRACK"
        ;;
    *)
        MESSAGE="$ACTION: $TRACK"
        ;;
esac

notify-send -t 1500 \
    -a 'osd' \
    -h string:x-canonical-private-synchronous:media \
    "$MESSAGE"
