#!/usr/bin/env bash

osd_media() {
    local prefix="$1" track
    track=$(mpc current)
    notify-send -t 1500 -a 'osd' -c 'media' \
        -h string:x-canonical-private-synchronous:media "${prefix}: $(basename "$track")"
}

SCOPE="${1:-global}"

case "$SCOPE" in
    global|add|queue) mpc update -q ;;
esac

if [ "$SCOPE" = "global" ]; then
    CHOICE=$(mpc listall | tofi --prompt-text="play (album): ")
    [ -z "$CHOICE" ] && exit 0

    DIRNAME=$(dirname "$CHOICE")

    mpc clear -q
    mpc -q random off

    if [ "$DIRNAME" = "." ]; then
        mpc add "$CHOICE"
        mpc -q play 1
    else
        mpc add "$DIRNAME"
        POS=$(mpc -f '%file%' playlist | grep -nFx -- "$CHOICE" | head -n 1 | cut -d: -f1)
        if [ -n "$POS" ]; then
            mpc -q play "$POS"
        else
            mpc -q play 1
        fi
    fi

    sleep 0.3
    mpc status | grep -q '\[playing\]' || { mpc -q play 1; sleep 0.3; }

    osd_media "playing"

elif [ "$SCOPE" = "add" ]; then
    CHOICE=$(mpc listall | tofi --prompt-text="add to queue: ")
    [ -z "$CHOICE" ] && exit 0

    mpc add "$CHOICE"

    TRACK_NAME=$(basename "$CHOICE" | tr '[:upper:]' '[:lower:]')
    notify-send -t 1500 -a "mpd" "added to queue" "$TRACK_NAME"

elif [ "$SCOPE" = "queue" ]; then
    MAP=$(mpc -f '%position%\t%title%\t%file%' playlist)
    [ -z "$MAP" ] && exit 0

    DISPLAY=$(printf '%s\n' "$MAP" | awk -F'\t' '{ label=$2; if(label==""){n=split($3,a,"/"); label=a[n]} printf "%d. %s\n", $1, label }')
    PROMPT="queue: "
    mpc status | grep -q 'random: on' && PROMPT="queue (shuffled): "
    CHOICE=$(printf '%s\n' "$DISPLAY" | tofi --prompt-text="$PROMPT")
    [ -z "$CHOICE" ] && exit 0

    POS=${CHOICE%%.*}
    [ -n "$POS" ] && mpc -q play "$POS"

    osd_media "playing"

elif [ "$SCOPE" = "toggle" ]; then
    playerctl play-pause 2>/dev/null || true
    sleep 0.2
    STATUS=$(playerctl status 2>/dev/null || true)
    TRACK=$(playerctl metadata --format '{{ artist }} - {{ title }}' 2>/dev/null || true)
    [ -n "$TRACK" ] || TRACK="unknown track"
    MESSAGE="$(printf '%s' "$STATUS" | tr '[:upper:]' '[:lower:]'): $TRACK"
    notify-send -t 1500 -a 'osd' -c 'media' -h string:x-canonical-private-synchronous:media "$MESSAGE"

elif [ "$SCOPE" = "next" ]; then
    playerctl next 2>/dev/null || true
    sleep 0.2
    TRACK=$(playerctl metadata --format '{{ artist }} - {{ title }}' 2>/dev/null || true)
    [ -n "$TRACK" ] || TRACK="unknown track"
    notify-send -t 1500 -a 'osd' -c 'media' -h string:x-canonical-private-synchronous:media "next: $TRACK"

elif [ "$SCOPE" = "prev" ]; then
    playerctl previous 2>/dev/null || true
    sleep 0.2
    TRACK=$(playerctl metadata --format '{{ artist }} - {{ title }}' 2>/dev/null || true)
    [ -n "$TRACK" ] || TRACK="unknown track"
    notify-send -t 1500 -a 'osd' -c 'media' -h string:x-canonical-private-synchronous:media "previous: $TRACK"

elif [ "$SCOPE" = "shuffle" ]; then
    mpc random -q
    STATE=$(mpc status | grep -o 'random: [a-z]*' | awk '{print $2}')
    notify-send -t 1500 -a 'osd' -c 'media' -h string:x-canonical-private-synchronous:media "shuffle $STATE"

elif [ "$SCOPE" = "repeat" ]; then
    mpc repeat -q
    STATE=$(mpc status | grep -o 'repeat: [a-z]*' | awk '{print $2}')
    notify-send -t 1500 -a 'osd' -c 'media' -h string:x-canonical-private-synchronous:media "repeat $STATE"

elif [ "$SCOPE" = "consume" ]; then
    mpc -q consume
    STATE=$(mpc status | grep -o 'consume: [a-z]*' | awk '{print $2}')
    notify-send -t 1500 -a 'osd' -c 'media' -h string:x-canonical-private-synchronous:media "consume $STATE"

elif [ "$SCOPE" = "seek" ]; then
    PERCENT="${2:-0}"
    DURATION_US=$(playerctl metadata --format '{{ mpris:length }}' 2>/dev/null)
    if [ -n "$DURATION_US" ] && [ "$DURATION_US" -gt 0 ] 2>/dev/null; then
        DURATION_S=$((DURATION_US / 1000000))
        SEEK_S=$((DURATION_S * PERCENT / 100))
        playerctl position "$SEEK_S" 2>/dev/null || true
    else
        mpc -q seek "${PERCENT}%"
    fi
    sleep 0.15
    POS=$(mpc status | grep -oE '\([0-9]+%\)' | tr -d '()%')
    TIME=$(mpc status | grep -oE '[0-9]+:[0-9]+/[0-9]+:[0-9]+' | head -n 1)
    [ -n "$POS" ] || POS="$PERCENT"
    notify-send -t 1000 -a 'osd' -c 'media' \
        -h string:x-canonical-private-synchronous:media \
        -h int:value:"$POS" "${TIME:-${PERCENT}%}"

elif [ "$SCOPE" = "clear" ]; then
    mpc clear -q
    notify-send -t 1500 -a 'osd' -c 'media' -h string:x-canonical-private-synchronous:media "queue cleared"
fi
