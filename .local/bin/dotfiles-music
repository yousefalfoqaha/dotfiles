#!/usr/bin/env bash

MODE_MUSIC='mode "music"'

osd() {
    local class="$1" msg="$2" timeout="${3:-1500}"
    notify-send -t "$timeout" -a 'osd' -c "$class" \
        -h string:x-canonical-private-synchronous:media "$msg"
}

osd_media() {
    local prefix="$1" track
    track=$(playerctl --player=mpd metadata --format '{{ artist }} - {{ title }}' 2>/dev/null || true)
    [ -n "$track" ] && osd osd-text-large "${prefix}: $track"
}

back_to_mode() {
    swaymsg "$MODE_MUSIC" 2>/dev/null || true
    exit 0
}

SCOPE="${1:-global}"

case "$SCOPE" in
    global|add|queue) mpc update -q --wait ;;
esac

case "$SCOPE" in
    global)
        CHOICE=$(mpc ls | tofi --prompt-text="album: ")
        [ -z "$CHOICE" ] && back_to_mode

        mpc clear -q
        mpc add "$CHOICE"
        mpc -q play 1
        mpc status | grep -q '\[playing\]' || mpc -q play 1

        osd_media "playing"
        back_to_mode
        ;;

    add)
        CHOICE=$(mpc listall | tofi --prompt-text="add to queue: ")
        [ -z "$CHOICE" ] && back_to_mode

        mpc -q insert "$CHOICE"

        TRACK_NAME=$(basename "$CHOICE" | tr '[:upper:]' '[:lower:]')
        osd osd-text-large "added: $TRACK_NAME"
        back_to_mode
        ;;

    queue)
        MAP=$(mpc -f '%position%\t%artist%\t%title%\t%file%' playlist)
        [ -z "$MAP" ] && back_to_mode

        CURRENT_POS=$(mpc -f '%position%' current 2>/dev/null)
        DISPLAY=$(printf '%s\n' "$MAP" | awk -F'\t' -v cur="$CURRENT_POS" '{
            artist=$2; title=$3
            if (title == "") {
                n=split($4,a,"/")
                label=a[n]
            } else if (artist == "") {
                label=title
            } else {
                label=artist " - " title
            }
            if ($1 == cur) printf "* %d. %s\n", $1, label
            else printf "  %d. %s\n", $1, label
        }')
        CHOICE=$(printf '%s\n' "$DISPLAY" | tofi --prompt-text="queue: ")
        [ -z "$CHOICE" ] && back_to_mode

        POS="${CHOICE#\* }"
        POS="${POS#  }"
        POS=${POS%%.*}
        [ -n "$POS" ] && mpc -q play "$POS"

        osd_media "playing"
        back_to_mode
        ;;

    toggle)
        playerctl --player=mpd play-pause 2>/dev/null || true
        STATUS=$(playerctl --player=mpd status 2>/dev/null || true)
        osd_media "$(printf '%s' "$STATUS" | tr '[:upper:]' '[:lower:]')"
        ;;

    next)
        playerctl --player=mpd next 2>/dev/null || true
        osd_media "next"
        ;;

    prev)
        playerctl --player=mpd previous 2>/dev/null || true
        osd_media "previous"
        ;;

    repeat)
        REPEAT=$(mpc status | grep -o 'repeat: [a-z]*' | awk '{print $2}')
        SINGLE=$(mpc status | grep -o 'single: [a-z]*' | awk '{print $2}')

        if [ "$REPEAT" = "off" ]; then
            mpc -q repeat on
            mpc -q single off
            STATE="repeat"
        elif [ "$REPEAT" = "on" ] && [ "$SINGLE" = "off" ]; then
            mpc -q single on
            STATE="repeat single"
        else
            mpc -q repeat off
            mpc -q single off
            STATE="repeat off"
        fi
        osd osd-text-small "$STATE"
        ;;

    remove)
        POS=$(mpc -f '%position%' current 2>/dev/null)
        if [ -n "$POS" ]; then
            mpc -q del "$POS"
            osd_media "next"
        fi
        ;;

    seek)
        mpc status | grep -qE '\[playing\]|\[paused\]' || exit 0
        PERCENT="${2:-0}"
        mpc -q seek "${PERCENT}%" 2>/dev/null || true
        POS=$(mpc status | grep -oE '\([0-9]+%\)' | tr -d '()%')
        TIME=$(mpc status | grep -oE '[0-9]+:[0-9]+/[0-9]+:[0-9]+' | head -n 1)
        [ -n "$POS" ] || POS="$PERCENT"
        notify-send -t 1000 -a 'osd' -c 'osd-progress' \
            -h string:x-canonical-private-synchronous:media \
            -h int:value:"$POS" "${TIME:-${PERCENT}%}"
        ;;

    seekrel)
        mpc status | grep -qE '\[playing\]|\[paused\]' || exit 0
        OFFSET="${2:-0}"
        mpc -q seek "${OFFSET}" 2>/dev/null || true
        POS=$(mpc status | grep -oE '\([0-9]+%\)' | tr -d '()%')
        TIME=$(mpc status | grep -oE '[0-9]+:[0-9]+/[0-9]+:[0-9]+' | head -n 1)
        [ -n "$POS" ] || POS=0
        notify-send -t 1000 -a 'osd' -c 'osd-progress' \
            -h string:x-canonical-private-synchronous:media \
            -h int:value:"$POS" "${TIME:-${OFFSET}s}"
        ;;

    clear)
        mpc clear -q
        osd osd-text-small "queue cleared"
        ;;
esac
