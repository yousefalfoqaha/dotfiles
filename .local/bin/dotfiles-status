#!/usr/bin/env bash

BAT_DIR=""
for b in /sys/class/power_supply/BAT*; do
    if [ -d "$b" ]; then
        BAT_DIR="$b"
        break
    fi
done

while true; do
    status_elements=()

    # MUSIC
    MPC_STATUS=$(mpc status 2>/dev/null)
    
    if [[ "$MPC_STATUS" == *"[playing]"* ]] || [[ "$MPC_STATUS" == *"[paused]"* ]]; then
        [[ "$MPC_STATUS" =~ \#([0-9]+/[0-9]+) ]] && POS="${BASH_REMATCH[1]}"
        [[ "$MPC_STATUS" =~ ([0-9]+:[0-9]+/[0-9]+:[0-9]+) ]] && TIME="${BASH_REMATCH[1]}"
        [[ "$MPC_STATUS" =~ volume:[[:space:]]*([0-9]+%) ]] && VOL="vol ${BASH_REMATCH[1]}"

        TRACK=$(mpc current 2>/dev/null)
        TRACK="${TRACK##*/}"
        TRACK="${TRACK%.*}"
        TRACK="${TRACK:0:75}$([[ ${#TRACK} -gt 75 ]] && echo "…")"

        OPTS_ARR=()
        [[ "$MPC_STATUS" == *"single: on"* ]] && OPTS_ARR+=("rpt 1") \
        || { [[ "$MPC_STATUS" == *"repeat: on"* ]] && OPTS_ARR+=("rpt"); }
        [[ "$MPC_STATUS" == *"random: on"* ]] && OPTS_ARR+=("shf")

        OPTS="${OPTS_ARR[*]}"
        RAW="$POS $TRACK $TIME $OPTS $VOL"
        status_elements+=("${RAW//  / }") 

    elif [[ -n "$(mpc playlist 2>/dev/null)" ]]; then
        COUNT=$(mpc playlist 2>/dev/null | wc -l)
        [[ "$MPC_STATUS" =~ volume:[[:space:]]*([0-9]+%) ]] && VOL="vol ${BASH_REMATCH[1]}"
        RAW="$COUNT song(s) queued $VOL"
        status_elements+=("${RAW//  / }")
    fi

    # BLUETOOTH
    BT_DEVS=$(bluetoothctl devices Connected 2>/dev/null)
    if [[ -n "$BT_DEVS" ]]; then
        BT_CONNS=$(echo "$BT_DEVS" | wc -l)
        status_elements+=("bt ${BT_CONNS}")
    else
        status_elements+=("bt")
    fi

    # NETWORK
    NM_OUT=$(nmcli -t -f TYPE,STATE dev 2>/dev/null)
    if [[ "$NM_OUT" == *"wifi:connected"* ]] || [[ "$NM_OUT" == *"802-11-wireless:connected"* ]]; then
        WIFI_OUT=$(nmcli -t -f IN-USE,SIGNAL dev wifi 2>/dev/null)
        [[ "$WIFI_OUT" =~ \*+:([0-9]+) ]] && SIGNAL="${BASH_REMATCH[1]}"
        status_elements+=("wifi ${SIGNAL}%")
    elif [[ "$NM_OUT" == *"ethernet:connected"* ]] || [[ "$NM_OUT" == *"802-3-ethernet:connected"* ]]; then
        status_elements+=("eth")
    else
        status_elements+=("offline")
    fi

    # VOLUME
    VOL_RAW=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || echo "Volume: 0")
    if [[ "$VOL_RAW" == *"MUTED"* ]]; then
        status_elements+=("muted")
    else
        [[ "$VOL_RAW" =~ [0-9]+\.[0-9]+ ]] && VOL_NUM="${BASH_REMATCH[0]}"
        VOL_PCT=${VOL_NUM/./}
        VOL_PCT=$((10#$VOL_PCT)) 
        status_elements+=("vol ${VOL_PCT}%")
    fi

    # BATTERY
    if [[ -f "$BAT_DIR/uevent" ]]; then
        while IFS='=' read -r key val; do
            case "$key" in
                POWER_SUPPLY_CAPACITY) BAT_CAP="$val" ;;
                POWER_SUPPLY_STATUS)   BAT_STAT="$val" ;;
            esac
        done < "$BAT_DIR/uevent"
        
        case "$BAT_STAT" in
            "Charging")    status_elements+=("chr ${BAT_CAP}%") ;;
            "Full")        status_elements+=("bat full") ;;
            *)             status_elements+=("bat ${BAT_CAP}%") ;;
        esac
    fi

    # TIME
    printf -v TIME_STR "%(%I:%M %p)T" -1
    status_elements+=("$TIME_STR")

    # OUTPUT
    printf -v joined "%s :: " "${status_elements[@]}"
    echo "${joined% :: }"

    sleep 1
done
