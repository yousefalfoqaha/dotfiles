#!/usr/bin/env bash

BAT_DIR=""
for b in /sys/class/power_supply/BAT*; do
    if [ -d "$b" ]; then
        BAT_DIR="$b"
        break
    fi
done

while true; do
    status_elements=()

    # music
    MPC_STATUS=$(mpc status 2>/dev/null)
    if echo "$MPC_STATUS" | grep -q '\[playing\]'; then
        POS=$(echo "$MPC_STATUS" | grep -oE '#[0-9]+/[0-9]+' | tr -d '#')
        TRACK=$(basename "$(mpc current 2>/dev/null)" | sed 's/\.[^.]*$//')
        [ ${#TRACK} -gt 100 ] && TRACK="${TRACK:0:24}…"

        MODIFIERS=""
        echo "$MPC_STATUS" | grep -q 'random: on' && MODIFIERS="s"
        echo "$MPC_STATUS" | grep -q 'repeat: on' && MODIFIERS="${MODIFIERS:+$MODIFIERS, }r"

        if [ -n "$MODIFIERS" ]; then
            status_elements+=("$POS ($MODIFIERS) $TRACK")
        else
            status_elements+=("$POS $TRACK")
        fi
    fi

    # bt
    if command -v bluetoothctl >/dev/null 2>&1 && bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; then
        BT_CONNS=$(bluetoothctl devices Connected 2>/dev/null | wc -l)
        if [ "$BT_CONNS" -gt 0 ]; then
            status_elements+=("bt ${BT_CONNS}")
        else
            status_elements+=("bt")
        fi
    fi

    # net
    if command -v nmcli >/dev/null 2>&1; then
        if nmcli -t -f TYPE,STATE dev 2>/dev/null | grep -q -E '^(wifi|802-11-wireless):connected'; then
            SIGNAL=$(nmcli -t -f IN-USE,SIGNAL dev wifi 2>/dev/null | grep '^\*' | cut -d':' -f2 | head -n1)
            status_elements+=("wifi ${SIGNAL}%")
        elif nmcli -t -f TYPE,STATE dev 2>/dev/null | grep -q -E '^(ethernet|802-3-ethernet):connected'; then
            status_elements+=("eth")
        else
            status_elements+=("offline")
        fi
    fi

    # vol
    VOL_RAW=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || echo "Volume: 0")
    if [[ "$VOL_RAW" == *"MUTED"* ]]; then
        status_elements+=("muted")
    else
        VOL_PCT=$(echo "$VOL_RAW" | awk '{print int($2 * 100)}')
        status_elements+=("vol ${VOL_PCT}%")
    fi

    # bat
    if [ -n "$BAT_DIR" ] && [ -f "$BAT_DIR/capacity" ]; then
        BAT_CAP=$(< "$BAT_DIR/capacity")
        BAT_STAT=$(< "$BAT_DIR/status")
        
        case "$BAT_STAT" in
            "Charging")    status_elements+=("chr ${BAT_CAP}%") ;;
            "Full")        status_elements+=("bat full") ;;
            *)             status_elements+=("bat ${BAT_CAP}%") ;;
        esac
    fi

    # time
    status_elements+=("$(date +'%I:%M %p')")

    printf -v joined "%s :: " "${status_elements[@]}"
    echo "${joined% :: }"

    sleep 1
done
